# AI Gateway MVP environment example
# Copy this file to .env before deployment:
#   cp .env.example .env
#   nano .env

# Application
APP_PORT=3000
TZ=Asia/Shanghai
NODE_NAME=ai-gateway-mvp-1
FRONTEND_BASE_URL=http://localhost:3000
TRUSTED_REDIRECT_DOMAINS=localhost,127.0.0.1

# Security
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Database
POSTGRES_PASSWORD=change-me-postgres-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# Logs and batch update
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true

# Optional timeout settings
# RELAY_TIMEOUT=0
# STREAMING_TIMEOUT=300

# Optional media token statistics
# GET_MEDIA_TOKEN=true
# GET_MEDIA_TOKEN_NOT_STREAM=false

# Optional LinuxDo OAuth endpoints
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user
